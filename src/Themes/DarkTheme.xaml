<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== DARK THEME PALETTE ===== -->

    <!-- Backgrounds -->
    <Color x:Key="BackgroundColor">#FF1A1A2E</Color>
    <Color x:Key="SurfaceColor">#FF16213E</Color>
    <Color x:Key="Surface2Color">#FF0F3460</Color>
    <Color x:Key="CardColor">#FF1E2A45</Color>
    <Color x:Key="BorderColor">#FF2D3A5E</Color>
    <Color x:Key="DividerColor">#FF253050</Color>

    <!-- Accent / Primary -->
    <Color x:Key="AccentColor">#FF00D4FF</Color>
    <Color x:Key="AccentDarkColor">#FF0099CC</Color>
    <Color x:Key="AccentLightColor">#FF66E5FF</Color>
    <Color x:Key="PrimaryColor">#FF533483</Color>
    <Color x:Key="SecondaryColor">#FFE94560</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFEEF2FF</Color>
    <Color x:Key="TextSecondaryColor">#FFAAB4C8</Color>
    <Color x:Key="TextDisabledColor">#FF5A6480</Color>
    <Color x:Key="TextMutedColor">#FF7A88A8</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#FF00E676</Color>
    <Color x:Key="WarningColor">#FFFFAB00</Color>
    <Color x:Key="ErrorColor">#FFFF5252</Color>
    <Color x:Key="InfoColor">#FF40C4FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Accent gradient for progress bar -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF533483" Offset="0"/>
        <GradientStop Color="#FF00D4FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Header gradient -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1A1A2E" Offset="0"/>
        <GradientStop Color="#FF16213E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Button hover background -->
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF2A3A5E"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FF0F2A4E"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#3300D4FF"/>

    <!-- ===== TYPOGRAPHY ===== -->
    <FontFamily x:Key="FontFamilyDefault">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="FontSizeSmall" xmlns:sys="clr-namespace:System;assembly=System.Runtime">11</sys:Double>
    <sys:Double x:Key="FontSizeNormal" xmlns:sys="clr-namespace:System;assembly=System.Runtime">13</sys:Double>
    <sys:Double x:Key="FontSizeMedium" xmlns:sys="clr-namespace:System;assembly=System.Runtime">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge" xmlns:sys="clr-namespace:System;assembly=System.Runtime">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle" xmlns:sys="clr-namespace:System;assembly=System.Runtime">20</sys:Double>
    <sys:Double x:Key="FontSizeH1" xmlns:sys="clr-namespace:System;assembly=System.Runtime">24</sys:Double>

    <!-- ===== CORNER RADII ===== -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXL">16</CornerRadius>

</ResourceDictionary>
