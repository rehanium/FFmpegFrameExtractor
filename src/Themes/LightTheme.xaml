<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== LIGHT THEME PALETTE ===== -->

    <!-- Backgrounds -->
    <Color x:Key="BackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="Surface2Color">#FFEEEEEE</Color>
    <Color x:Key="CardColor">#FFFAFAFA</Color>
    <Color x:Key="BorderColor">#FFE0E0E0</Color>
    <Color x:Key="DividerColor">#FFBDBDBD</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#FF1976D2</Color>
    <Color x:Key="AccentDarkColor">#FF0D47A1</Color>
    <Color x:Key="AccentLightColor">#FF42A5F5</Color>
    <Color x:Key="PrimaryColor">#FF512DA8</Color>
    <Color x:Key="SecondaryColor">#FFE91E63</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FF212121</Color>
    <Color x:Key="TextSecondaryColor">#FF616161</Color>
    <Color x:Key="TextDisabledColor">#FF9E9E9E</Color>
    <Color x:Key="TextMutedColor">#FF757575</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#FF2E7D32</Color>
    <Color x:Key="WarningColor">#FFF57F17</Color>
    <Color x:Key="ErrorColor">#FFC62828</Color>
    <Color x:Key="InfoColor">#FF0277BD</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF512DA8" Offset="0"/>
        <GradientStop Color="#FF1976D2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF5F5F5" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFE3F2FD"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FFBBDEFB"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#11000000"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#221976D2"/>

    <!-- Typography -->
    <FontFamily x:Key="FontFamilyDefault">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="FontSizeSmall" xmlns:sys="clr-namespace:System;assembly=System.Runtime">11</sys:Double>
    <sys:Double x:Key="FontSizeNormal" xmlns:sys="clr-namespace:System;assembly=System.Runtime">13</sys:Double>
    <sys:Double x:Key="FontSizeMedium" xmlns:sys="clr-namespace:System;assembly=System.Runtime">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge" xmlns:sys="clr-namespace:System;assembly=System.Runtime">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle" xmlns:sys="clr-namespace:System;assembly=System.Runtime">20</sys:Double>
    <sys:Double x:Key="FontSizeH1" xmlns:sys="clr-namespace:System;assembly=System.Runtime">24</sys:Double>

    <!-- Corner Radii -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXL">16</CornerRadius>

</ResourceDictionary>
